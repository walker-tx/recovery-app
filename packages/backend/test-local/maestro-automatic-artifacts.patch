+    fun `suppression blocks failed and warned automatic captures with either capture mode`() {
+        for (fullCapture in listOf(false, true)) {
+            for (outcome in listOf(CommandOutcome.Failed(RuntimeException("failure")), CommandOutcome.Warned)) {
+                val dir = Files.createTempDirectory(tempDir, "suppressed-")
+                val maestro = mockMaestro()
+                val gen = ArtifactsGenerator(
