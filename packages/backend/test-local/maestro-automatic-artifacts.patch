+                    maestro = maestro,
+                    captureFullArtifacts = fullCapture,
+                    suppressAutomaticArtifacts = true,
+                )
+                val cmd = MaestroCommand(scrollCommand = ScrollCommand())
+
+                gen.onFlowStart()
